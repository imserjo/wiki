DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/knowledge_base
DB_SCHEMA=notes
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_PREFIX=/wiki

# Базовый URL приложения (для ссылок в письмах)
APP_BASE_URL=http://127.0.0.1:8000

# SMTP для отправки писем
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your-email@yandex.ru
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@yandex.ru
SMTP_USE_SSL=true

# Google OAuth (если хотите вход через Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
